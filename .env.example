# ───────────── BillBridge environment (copy to .env) ─────────────
NODE_ENV=development
DEMO_MODE=true

# Ledger: auto | fabric | mock  (auto = try Fabric/Drunix health ≤90s, then mock)
LEDGER_MODE=auto
MOCK_LEDGER_FILE=.data/ledger.json
# Fabric / Drunix gateway (only used when LEDGER_MODE=fabric|auto)
FABRIC_CHANNEL=billbridge
FABRIC_CHAINCODE=billbridge
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
FABRIC_IDENTITIES_DIR=./identities

# Backend
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL="file:./dev.db"
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-min
UPI_WEBHOOK_SECRET=change-me-upi-webhook-secret
UPI_PLATFORM_VPA=billbridge@upi
UPLOAD_DIR=./uploads
LOG_LEVEL=info

# AI extraction (optional; fallback = pdf-parse heuristics)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# NPCI sandbox UPI provider (optional stub; unset = SimulatedUpiProvider)
NPCI_SANDBOX_BASE_URL=
NPCI_SANDBOX_CLIENT_ID=
NPCI_SANDBOX_CLIENT_SECRET=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
