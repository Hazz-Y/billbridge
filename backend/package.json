{
  "name": "@billbridge/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push --skip-generate",
    "seed": "tsx src/demo/seed-cli.ts",
    "samples": "tsx ../samples/generate.ts"
  },
  "dependencies": {
    "@billbridge/shared": "0.1.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@google/genai": "^1.0.0",
    "@grpc/grpc-js": "^1.12.4",
    "@hyperledger/fabric-gateway": "^1.7.0",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "fastify-raw-body": "^5.0.0",
    "fastify-type-provider-zod": "^4.0.2",
    "pdf-parse": "1.1.1",
    "pdfkit": "^0.15.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.1.0",
    "qrcode": "^1.5.4",
    "tesseract.js": "^5.1.1",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.4",
    "@types/pdfkit": "^0.13.8",
    "@types/qrcode": "^1.5.5",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
