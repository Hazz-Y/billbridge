{
  "name": "double-financing: identity / content / file guards, incl. cancelled-then-recreate",
  "config": { "demoMode": true },
  "identities": {
    "op": { "mspId": "Org1MSP", "role": "OPERATOR", "participantId": "operator1" },
    "msme1": { "mspId": "Org1MSP", "role": "MSME", "participantId": "msme1" },
    "msme2": { "mspId": "Org1MSP", "role": "MSME", "participantId": "msme2" },
    "buyer1": { "mspId": "Org2MSP", "role": "BUYER", "participantId": "buyer1" }
  },
  "steps": [
    { "caller": "op", "fn": "RegisterParticipant", "args": ["msme1", "MSME", "Org1MSP", 0] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["msme2", "MSME", "Org1MSP", 0] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["buyer1", "BUYER", "Org2MSP", 0] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["msme1", "APPROVED", ""] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["msme2", "APPROVED", ""] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["buyer1", "APPROVED", ""] },
    { "id": "orig", "caller": "msme1", "fn": "CreateInvoice",
      "args": ["msme1", "buyer1", 40000000, "2026-02-25", "2026-05-07",
        { "supplierGstin": "27AAACS1234A1ZX", "buyerGstin": "27AABCA3456D1ZX", "invoiceNumber": "INV-2025-001", "fileHash": "aaaa000000000000000000000000000000000000000000000000000000000001",
          "lineItems": [ { "description": "CNC housings", "quantity": 400, "unitPricePaise": 52000, "totalPaise": 20800000 } ] }],
      "expect": { "result": { "status": "DRAFT" } } },

    { "caller": "msme1", "fn": "CreateInvoice", "note": "ATTACK 1: same PDF re-uploaded (same everything) -> identity guard fires first",
      "args": ["msme1", "buyer1", 40000000, "2026-02-25", "2026-05-07",
        { "supplierGstin": "27AAACS1234A1ZX", "buyerGstin": "27AABCA3456D1ZX", "invoiceNumber": "INV-2025-001", "fileHash": "aaaa000000000000000000000000000000000000000000000000000000000001", "lineItems": [ { "description": "CNC housings", "quantity": 400, "unitPricePaise": 52000, "totalPaise": 20800000 } ] }],
      "expect": { "error": "ERR_DUPLICATE_INVOICE_ID" } },

    { "caller": "msme1", "fn": "CreateInvoice", "note": "ATTACK: same invoice number, CHANGED amount + new file -> identity guard",
      "args": ["msme1", "buyer1", 50000000, "2026-02-25", "2026-05-07",
        { "supplierGstin": "27AAACS1234A1ZX", "buyerGstin": "27AABCA3456D1ZX", "invoiceNumber": "INV-2025-001", "fileHash": "aaaa000000000000000000000000000000000000000000000000000000000002", "lineItems": [ { "description": "Other", "quantity": 1, "unitPricePaise": 1, "totalPaise": 1 } ] }],
      "expect": { "error": "ERR_DUPLICATE_INVOICE_ID" } },

    { "caller": "msme1", "fn": "CreateInvoice", "note": "ATTACK: invoice number lower-cased / spaced -> still same identity",
      "args": ["msme1", "buyer1", 40000000, "2026-02-25", "2026-05-07",
        { "supplierGstin": "27aaacs1234a1zx", "buyerGstin": "27AABCA3456D1ZX", "invoiceNumber": " inv-2025-001 ", "fileHash": "aaaa000000000000000000000000000000000000000000000000000000000003", "lineItems": [] }],
      "expect": { "error": "ERR_DUPLICATE_INVOICE_ID" } },

    { "caller": "msme1", "fn": "CreateInvoice", "note": "ATTACK 2: NEW invoice number, identical content, new file -> content guard",
      "args": ["msme1", "buyer1", 40000000, "2026-02-25", "2026-05-07",
        { "supplierGstin": "27AAACS1234A1ZX", "buyerGstin": "27AABCA3456D1ZX", "invoiceNumber": "INV-2025-001-A", "fileHash": "aaaa000000000000000000000000000000000000000000000000000000000004", "lineItems": [ { "description": "  cnc   HOUSINGS ", "quantity": 400, "unitPricePaise": 52000, "totalPaise": 20800000 } ] }],
      "expect": { "error": "ERR_DUPLICATE_INVOICE_CONTENT" } },

    { "caller": "msme1", "fn": "CreateInvoice", "note": "ATTACK 3: new number, different content, SAME PDF bytes -> file guard",
      "args": ["msme1", "buyer1", 30000000, "2026-02-26", "2026-05-07",
        { "supplierGstin": "27AAACS1234A1ZX", "buyerGstin": "27AABCA3456D1ZX", "invoiceNumber": "INV-2025-002", "fileHash": "aaaa000000000000000000000000000000000000000000000000000000000001", "lineItems": [ { "description": "Bolts", "quantity": 10, "unitPricePaise": 100, "totalPaise": 1000 } ] }],
      "expect": { "error": "ERR_DUPLICATE_FILE" } },

    { "caller": "msme2", "fn": "CreateInvoice", "note": "different supplier GSTIN, same number -> different identity, OK",
      "args": ["msme2", "buyer1", 40000000, "2026-02-25", "2026-05-07",
        { "supplierGstin": "33AABCK5678B1ZX", "buyerGstin": "27AABCA3456D1ZX", "invoiceNumber": "INV-2025-001", "fileHash": "aaaa000000000000000000000000000000000000000000000000000000000005", "lineItems": [ { "description": "CNC housings", "quantity": 400, "unitPricePaise": 52000, "totalPaise": 20800000 } ] }],
      "expect": { "result": { "status": "DRAFT", "supplierId": "msme2" } } },

    { "caller": "msme1", "fn": "CancelInvoice", "args": ["$orig.invoiceId", "mistake"], "expect": { "result": { "status": "CANCELLED", "cancelReason": "mistake" } }, "events": ["INVOICE_CANCELLED"] },
    { "caller": "msme1", "fn": "CreateInvoice", "note": "cancelled identity is burned -> still rejected",
      "args": ["msme1", "buyer1", 40000000, "2026-02-25", "2026-05-07",
        { "supplierGstin": "27AAACS1234A1ZX", "buyerGstin": "27AABCA3456D1ZX", "invoiceNumber": "INV-2025-001", "fileHash": "aaaa000000000000000000000000000000000000000000000000000000000006", "lineItems": [] }],
      "expect": { "error": "ERR_DUPLICATE_INVOICE_ID" } },
    { "caller": "msme1", "fn": "CreateInvoice", "note": "cancelled content is burned too",
      "args": ["msme1", "buyer1", 40000000, "2026-02-25", "2026-05-07",
        { "supplierGstin": "27AAACS1234A1ZX", "buyerGstin": "27AABCA3456D1ZX", "invoiceNumber": "INV-2025-001-B", "fileHash": "aaaa000000000000000000000000000000000000000000000000000000000007", "lineItems": [ { "description": "CNC housings", "quantity": 400, "unitPricePaise": 52000, "totalPaise": 20800000 } ] }],
      "expect": { "error": "ERR_DUPLICATE_INVOICE_CONTENT" } },
    { "caller": "msme1", "fn": "CreateInvoice", "note": "cancelled file is burned too",
      "args": ["msme1", "buyer1", 10000000, "2026-02-25", "2026-05-07",
        { "supplierGstin": "27AAACS1234A1ZX", "buyerGstin": "27AABCA3456D1ZX", "invoiceNumber": "INV-2025-009", "fileHash": "aaaa000000000000000000000000000000000000000000000000000000000001", "lineItems": [ { "description": "x", "quantity": 1, "unitPricePaise": 1, "totalPaise": 1 } ] }],
      "expect": { "error": "ERR_DUPLICATE_FILE" } },

    { "caller": "msme1", "fn": "CreateInvoice", "note": "face not unit multiple",
      "args": ["msme1", "buyer1", 40000001, "2026-02-25", "2026-05-07",
        { "supplierGstin": "27AAACS1234A1ZX", "buyerGstin": "27AABCA3456D1ZX", "invoiceNumber": "INV-2025-010", "fileHash": "aaaa000000000000000000000000000000000000000000000000000000000010", "lineItems": [] }],
      "expect": { "error": "ERR_FACE_NOT_UNIT_MULTIPLE" } },
    { "caller": "msme1", "fn": "CreateInvoice", "note": "due before issue",
      "args": ["msme1", "buyer1", 40000000, "2026-05-07", "2026-02-25",
        { "supplierGstin": "27AAACS1234A1ZX", "buyerGstin": "27AABCA3456D1ZX", "invoiceNumber": "INV-2025-011", "fileHash": "aaaa000000000000000000000000000000000000000000000000000000000011", "lineItems": [] }],
      "expect": { "error": "ERR_INVALID_ARGUMENT" } },
    { "caller": "msme1", "fn": "CreateInvoice", "note": "unknown buyer",
      "args": ["msme1", "ghost", 40000000, "2026-02-25", "2026-05-07",
        { "supplierGstin": "27AAACS1234A1ZX", "buyerGstin": "27AABCA3456D1ZX", "invoiceNumber": "INV-2025-012", "fileHash": "aaaa000000000000000000000000000000000000000000000000000000000012", "lineItems": [] }],
      "expect": { "error": "ERR_PARTICIPANT_NOT_FOUND" } }
  ]
}
