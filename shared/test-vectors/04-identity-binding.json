{
  "name": "identity binding + role/MSP authorisation: nobody can act as another participant; regulator is read-only",
  "config": { "demoMode": true },
  "identities": {
    "op": { "mspId": "Org1MSP", "role": "OPERATOR", "participantId": "operator1" },
    "msme1": { "mspId": "Org1MSP", "role": "MSME", "participantId": "msme1" },
    "msme2": { "mspId": "Org1MSP", "role": "MSME", "participantId": "msme2" },
    "buyer1": { "mspId": "Org2MSP", "role": "BUYER", "participantId": "buyer1" },
    "buyer2": { "mspId": "Org2MSP", "role": "BUYER", "participantId": "buyer2" },
    "inv1": { "mspId": "Org1MSP", "role": "INVESTOR", "participantId": "investor1" },
    "inv2": { "mspId": "Org1MSP", "role": "INVESTOR", "participantId": "investor2" },
    "reg": { "mspId": "Org3MSP", "role": "REGULATOR", "participantId": "regulator1" },
    "buyerWrongMsp": { "mspId": "Org1MSP", "role": "BUYER", "participantId": "buyer1" },
    "fakeOperator": { "mspId": "Org2MSP", "role": "OPERATOR", "participantId": "operator1" },
    "unregisteredOp": { "mspId": "Org1MSP", "role": "OPERATOR", "participantId": "operatorX" },
    "roleLie": { "mspId": "Org1MSP", "role": "OPERATOR", "participantId": "msme1" }
  },
  "steps": [
    { "caller": "op", "fn": "RegisterParticipant", "args": ["msme1", "MSME", "Org1MSP", 0] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["msme2", "MSME", "Org1MSP", 0] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["buyer1", "BUYER", "Org2MSP", 0] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["buyer2", "BUYER", "Org2MSP", 0] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["investor1", "INVESTOR", "Org1MSP", 0] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["investor2", "INVESTOR", "Org1MSP", 0] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["regulator1", "REGULATOR", "Org3MSP", 0] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["msme1", "APPROVED", ""] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["msme2", "APPROVED", ""] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["buyer1", "APPROVED", ""] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["buyer2", "APPROVED", ""] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["investor1", "APPROVED", ""] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["investor2", "APPROVED", ""] },

    { "caller": "reg", "fn": "RegisterParticipant", "note": "regulator is read-only", "args": ["z", "MSME", "Org1MSP", 0], "expect": { "error": "ERR_UNAUTHORIZED_ROLE" } },
    { "caller": "reg", "fn": "FreezeParticipant", "args": ["msme1", "x"], "expect": { "error": "ERR_UNAUTHORIZED_ROLE" } },
    { "caller": "reg", "fn": "AdvanceDemoClock", "args": [10], "expect": { "error": "ERR_UNAUTHORIZED_ROLE" } },
    { "caller": "msme1", "fn": "RegisterParticipant", "note": "MSME cannot register participants", "args": ["z", "MSME", "Org1MSP", 0], "expect": { "error": "ERR_UNAUTHORIZED_ROLE" } },
    { "caller": "inv1", "fn": "SetKycStatus", "args": ["investor1", "APPROVED", ""], "expect": { "error": "ERR_UNAUTHORIZED_ROLE" } },
    { "caller": "buyerWrongMsp", "fn": "BuyerAcceptInvoice", "note": "BUYER cert under Org1MSP is rejected", "args": ["x"], "expect": { "error": "ERR_UNAUTHORIZED_ROLE" } },
    { "caller": "fakeOperator", "fn": "RegisterParticipant", "note": "OPERATOR cert under Org2MSP is rejected", "args": ["z", "MSME", "Org1MSP", 0], "expect": { "error": "ERR_UNAUTHORIZED_ROLE" } },
    { "caller": "unregisteredOp", "fn": "RegisterParticipant", "note": "operator cert but no participant record", "args": ["z", "MSME", "Org1MSP", 0], "expect": { "error": "ERR_PARTICIPANT_NOT_FOUND" } },
    { "caller": "roleLie", "fn": "RegisterParticipant", "note": "cert says OPERATOR but participant is MSME", "args": ["z", "MSME", "Org1MSP", 0], "expect": { "error": "ERR_UNAUTHORIZED_ROLE" } },

    { "caller": "msme1", "fn": "CreateInvoice", "note": "msme1 acting as msme2",
      "args": ["msme2", "buyer1", 10000000, "2026-02-25", "2026-05-07", { "supplierGstin": "S2", "buyerGstin": "B", "invoiceNumber": "N", "fileHash": "f", "lineItems": [] }],
      "expect": { "error": "ERR_IDENTITY_MISMATCH" } },
    { "id": "inv", "caller": "msme1", "fn": "CreateInvoice", "ts": "2026-03-01T10:00:00Z",
      "args": ["msme1", "buyer1", 10000000, "2026-02-25", "2026-05-07", { "supplierGstin": "S1", "buyerGstin": "B", "invoiceNumber": "N", "fileHash": "f", "lineItems": [] }],
      "expect": { "result": { "status": "DRAFT" } } },
    { "caller": "buyer2", "fn": "BuyerAcceptInvoice", "note": "wrong buyer", "args": ["$inv.invoiceId"], "expect": { "error": "ERR_IDENTITY_MISMATCH" } },
    { "caller": "msme2", "fn": "CancelInvoice", "note": "other MSME cannot cancel", "args": ["$inv.invoiceId", "x"], "expect": { "error": "ERR_IDENTITY_MISMATCH" } },
    { "caller": "buyer1", "fn": "BuyerAcceptInvoice", "args": ["$inv.invoiceId"], "expect": { "result": { "status": "BUYER_ACCEPTED" } } },
    { "caller": "op", "fn": "ListInvoice", "ts": "2026-03-01T10:00:00Z", "args": ["$inv.invoiceId", 1000, 1] },
    { "caller": "inv1", "fn": "Invest", "note": "investor1 acting as investor2", "args": ["$inv.invoiceId", "investor2", 1, "U-1"], "expect": { "error": "ERR_IDENTITY_MISMATCH" } },
    { "caller": "inv1", "fn": "Invest", "args": ["$inv.invoiceId", "investor1", 1, "U-1"], "expect": { "result": { "holding": { "holderId": "investor1" } } } },
    { "caller": "inv1", "fn": "ReleaseToSupplier", "note": "investor cannot release", "args": ["$inv.invoiceId", "P"], "expect": { "error": "ERR_UNAUTHORIZED_ROLE" } },
    { "caller": "buyer1", "fn": "RecordRepayment", "note": "buyer cannot self-record repayment", "args": ["$inv.invoiceId", "R", 10000000], "expect": { "error": "ERR_UNAUTHORIZED_ROLE" } }
  ]
}
