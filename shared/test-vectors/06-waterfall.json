{
  "name": "settlement waterfall: 7 holders, partially funded with residual, exact totals, holders sorted by id",
  "config": { "demoMode": true },
  "identities": {
    "op": { "mspId": "Org1MSP", "role": "OPERATOR", "participantId": "operator1" },
    "msme1": { "mspId": "Org1MSP", "role": "MSME", "participantId": "msme1" },
    "buyer1": { "mspId": "Org2MSP", "role": "BUYER", "participantId": "buyer1" },
    "h1": { "mspId": "Org1MSP", "role": "INVESTOR", "participantId": "h1" },
    "h2": { "mspId": "Org1MSP", "role": "INVESTOR", "participantId": "h2" },
    "h3": { "mspId": "Org1MSP", "role": "INVESTOR", "participantId": "h3" },
    "h4": { "mspId": "Org1MSP", "role": "INVESTOR", "participantId": "h4" },
    "h5": { "mspId": "Org1MSP", "role": "INVESTOR", "participantId": "h5" },
    "h6": { "mspId": "Org1MSP", "role": "INVESTOR", "participantId": "h6" },
    "h7": { "mspId": "Org1MSP", "role": "INVESTOR", "participantId": "h7" }
  },
  "steps": [
    { "caller": "op", "fn": "RegisterParticipant", "args": ["msme1", "MSME", "Org1MSP", 0] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["buyer1", "BUYER", "Org2MSP", 0] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["h1", "INVESTOR", "Org1MSP", 0] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["h2", "INVESTOR", "Org1MSP", 0] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["h3", "INVESTOR", "Org1MSP", 0] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["h4", "INVESTOR", "Org1MSP", 0] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["h5", "INVESTOR", "Org1MSP", 0] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["h6", "INVESTOR", "Org1MSP", 0] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["h7", "INVESTOR", "Org1MSP", 0] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["msme1", "APPROVED", ""] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["buyer1", "APPROVED", ""] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["h1", "APPROVED", ""] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["h2", "APPROVED", ""] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["h3", "APPROVED", ""] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["h4", "APPROVED", ""] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["h5", "APPROVED", ""] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["h6", "APPROVED", ""] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["h7", "APPROVED", ""] },

    { "id": "inv", "caller": "msme1", "fn": "CreateInvoice", "ts": "2026-03-01T10:00:00Z", "args": ["msme1", "buyer1", 1000000, "2026-02-25", "2026-05-07", { "supplierGstin": "S", "buyerGstin": "B", "invoiceNumber": "W", "fileHash": "fw", "lineItems": [] }], "expect": { "result": { "totalUnits": 10 } } },
    { "caller": "buyer1", "fn": "BuyerAcceptInvoice", "args": ["$inv.invoiceId"] },
    { "caller": "op", "fn": "ListInvoice", "ts": "2026-03-01T10:00:00Z", "args": ["$inv.invoiceId", 1000, 1], "expect": { "result": { "tenorDays": 67, "pricePerUnitPaise": 98165 } } },
    { "caller": "h7", "fn": "Invest", "args": ["$inv.invoiceId", "h7", 1, "u7"] },
    { "caller": "h3", "fn": "Invest", "args": ["$inv.invoiceId", "h3", 1, "u3"] },
    { "caller": "h1", "fn": "Invest", "args": ["$inv.invoiceId", "h1", 2, "u1"] },
    { "caller": "h5", "fn": "Invest", "args": ["$inv.invoiceId", "h5", 1, "u5"] },
    { "caller": "h2", "fn": "Invest", "args": ["$inv.invoiceId", "h2", 1, "u2"] },
    { "caller": "h6", "fn": "Invest", "args": ["$inv.invoiceId", "h6", 1, "u6"] },
    { "caller": "h4", "fn": "Invest", "args": ["$inv.invoiceId", "h4", 1, "u4"], "expect": { "result": { "invoice": { "unitsSold": 8, "status": "PARTIALLY_FUNDED" } } } },
    { "caller": "op", "fn": "ReleaseToSupplier", "args": ["$inv.invoiceId", "payout"], "expect": { "result": { "payment": { "amountPaise": 785320 } } } },
    { "caller": "op", "fn": "RecordRepayment", "ts": "2026-05-09T10:00:00Z", "args": ["$inv.invoiceId", "repay", 1000000],
      "expect": { "result": { "onTime": true,
        "distributions": [
          { "toId": "h1", "amountPaise": 200000, "upiRef": "repay-D0" }, { "toId": "h2", "amountPaise": 100000, "upiRef": "repay-D1" }, { "toId": "h3", "amountPaise": 100000 },
          { "toId": "h4", "amountPaise": 100000 }, { "toId": "h5", "amountPaise": 100000 }, { "toId": "h6", "amountPaise": 100000 }, { "toId": "h7", "amountPaise": 100000, "upiRef": "repay-D6" } ],
        "residual": { "amountPaise": 200000, "toId": "msme1", "upiRef": "repay-R" },
        "buyerScore": { "score": 100, "settledOnTime": 1 } } },
      "events": ["REPAYMENT_RECORDED", "DISTRIBUTION_PAID", "SCORE_UPDATED"] },
    { "caller": "op", "fn": "GetHoldingsByInvoice", "args": ["$inv.invoiceId"], "expect": { "result": [ { "holderId": "h1", "receivedPaise": 200000, "costPaise": 196330 }, { "holderId": "h2", "receivedPaise": 100000 }, { "holderId": "h3" }, { "holderId": "h4" }, { "holderId": "h5" }, { "holderId": "h6" }, { "holderId": "h7", "receivedPaise": 100000, "costPaise": 98165 } ] } },
    { "caller": "op", "fn": "GetPlatformStats", "args": [], "expect": { "result": { "activeInvestors": 7, "totalFundedPaise": 785320, "settledInvoices": 1 } } }
  ]
}
