{
  "name": "state machine: table of illegal transitions, min-funding, discount range, invest after release",
  "config": { "demoMode": true, "minDiscountBps": 100, "maxDiscountBps": 3000 },
  "identities": {
    "op": { "mspId": "Org1MSP", "role": "OPERATOR", "participantId": "operator1" },
    "msme1": { "mspId": "Org1MSP", "role": "MSME", "participantId": "msme1" },
    "buyer1": { "mspId": "Org2MSP", "role": "BUYER", "participantId": "buyer1" },
    "inv1": { "mspId": "Org1MSP", "role": "INVESTOR", "participantId": "investor1" }
  },
  "steps": [
    { "caller": "op", "fn": "RegisterParticipant", "args": ["msme1", "MSME", "Org1MSP", 0] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["buyer1", "BUYER", "Org2MSP", 0] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["investor1", "INVESTOR", "Org1MSP", 0] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["msme1", "APPROVED", ""] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["buyer1", "APPROVED", ""] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["investor1", "APPROVED", ""] },

    { "id": "a", "caller": "msme1", "fn": "CreateInvoice", "ts": "2026-03-01T10:00:00Z", "args": ["msme1", "buyer1", 1000000, "2026-02-25", "2026-05-07", { "supplierGstin": "S", "buyerGstin": "B", "invoiceNumber": "A", "fileHash": "fa", "lineItems": [] }] },
    { "caller": "op", "fn": "ListInvoice", "note": "DRAFT -> LISTED illegal", "args": ["$a.invoiceId", 800, 1], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "inv1", "fn": "Invest", "note": "DRAFT invest illegal", "args": ["$a.invoiceId", "investor1", 1, "x1"], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "op", "fn": "ReleaseToSupplier", "note": "DRAFT release illegal", "args": ["$a.invoiceId", "p1"], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "op", "fn": "RecordRepayment", "note": "DRAFT repay illegal", "args": ["$a.invoiceId", "r1", 1000000], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "op", "fn": "MarkLate", "note": "DRAFT late illegal", "args": ["$a.invoiceId"], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "op", "fn": "MarkDefault", "note": "DRAFT default illegal", "args": ["$a.invoiceId"], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "op", "fn": "CancelInvoice", "note": "operator cannot cancel DRAFT (MSME only)", "args": ["$a.invoiceId", "x"], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "buyer1", "fn": "BuyerAcceptInvoice", "args": ["$a.invoiceId"], "expect": { "result": { "status": "BUYER_ACCEPTED" } } },
    { "caller": "buyer1", "fn": "BuyerAcceptInvoice", "note": "double accept", "args": ["$a.invoiceId"], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "msme1", "fn": "CancelInvoice", "note": "MSME cannot cancel once accepted", "args": ["$a.invoiceId", "x"], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "inv1", "fn": "Invest", "note": "BUYER_ACCEPTED invest illegal", "args": ["$a.invoiceId", "investor1", 1, "x2"], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "op", "fn": "ListInvoice", "note": "discount below min", "args": ["$a.invoiceId", 99, 1], "expect": { "error": "ERR_DISCOUNT_OUT_OF_RANGE" } },
    { "caller": "op", "fn": "ListInvoice", "note": "discount above max", "args": ["$a.invoiceId", 3001, 1], "expect": { "error": "ERR_DISCOUNT_OUT_OF_RANGE" } },
    { "caller": "op", "fn": "ListInvoice", "note": "minFundingUnits > totalUnits", "args": ["$a.invoiceId", 800, 11], "expect": { "error": "ERR_INVALID_ARGUMENT" } },
    { "caller": "op", "fn": "ListInvoice", "note": "minFundingUnits 0", "args": ["$a.invoiceId", 800, 0], "expect": { "error": "ERR_INVALID_ARGUMENT" } },
    { "caller": "op", "fn": "ListInvoice", "note": "non-integer arg", "args": ["$a.invoiceId", "8%", 1], "expect": { "error": "ERR_INVALID_ARGUMENT" } },
    { "caller": "op", "fn": "ListInvoice", "ts": "2026-03-01T10:00:00Z", "args": ["$a.invoiceId", 800, 5], "expect": { "result": { "status": "LISTED", "totalUnits": 10, "minFundingUnits": 5 } } },
    { "caller": "op", "fn": "ListInvoice", "note": "double list", "args": ["$a.invoiceId", 800, 5], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "buyer1", "fn": "BuyerAcceptInvoice", "note": "accept on LISTED", "args": ["$a.invoiceId"], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "op", "fn": "ReleaseToSupplier", "note": "LISTED with zero units sold -> transition error", "args": ["$a.invoiceId", "p2"], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "op", "fn": "RecordRepayment", "note": "LISTED repay illegal", "args": ["$a.invoiceId", "r2", 1000000], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "inv1", "fn": "Invest", "note": "zero units", "args": ["$a.invoiceId", "investor1", 0, "x3"], "expect": { "error": "ERR_INVALID_ARGUMENT" } },
    { "caller": "inv1", "fn": "Invest", "note": "empty upiRef", "args": ["$a.invoiceId", "investor1", 1, ""], "expect": { "error": "ERR_INVALID_ARGUMENT" } },
    { "caller": "inv1", "fn": "Invest", "args": ["$a.invoiceId", "investor1", 3, "x4"], "expect": { "result": { "invoice": { "status": "PARTIALLY_FUNDED", "unitsSold": 3 } } } },
    { "caller": "op", "fn": "CancelInvoice", "note": "operator cannot cancel once units sold", "args": ["$a.invoiceId", "x"], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "op", "fn": "ReleaseToSupplier", "note": "3 < minFunding 5", "args": ["$a.invoiceId", "p3"], "expect": { "error": "ERR_BELOW_MIN_FUNDING" } },
    { "caller": "op", "fn": "MarkLate", "note": "PARTIALLY_FUNDED late illegal", "args": ["$a.invoiceId"], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "inv1", "fn": "Invest", "args": ["$a.invoiceId", "investor1", 2, "x5"], "expect": { "result": { "invoice": { "status": "PARTIALLY_FUNDED", "unitsSold": 5 }, "holding": { "units": 5, "upiRefs": ["x4", "x5"] } } } },
    { "caller": "op", "fn": "ReleaseToSupplier", "note": "reusing a funding upiRef is rejected", "args": ["$a.invoiceId", "x4"], "expect": { "error": "ERR_INVALID_ARGUMENT" } },
    { "caller": "op", "fn": "ReleaseToSupplier", "ts": "2026-03-02T10:00:00Z", "args": ["$a.invoiceId", "p4"], "expect": { "result": { "invoice": { "status": "SUPPLIER_PAID" }, "payment": { "amountPaise": 492660 } } } },
    { "caller": "inv1", "fn": "Invest", "note": "invest after SUPPLIER_PAID rejected", "args": ["$a.invoiceId", "investor1", 1, "x6"], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "op", "fn": "ReleaseToSupplier", "note": "double release", "args": ["$a.invoiceId", "p5"], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "op", "fn": "ListInvoice", "note": "SUPPLIER_PAID list illegal", "args": ["$a.invoiceId", 800, 5], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "op", "fn": "RecordRepayment", "ts": "2026-05-10T10:00:00Z", "args": ["$a.invoiceId", "r3", 1000000], "expect": { "result": { "invoice": { "status": "SETTLED" }, "residual": { "amountPaise": 500000, "toId": "msme1", "kind": "SUPPLIER_RESIDUAL" }, "distributions": [ { "amountPaise": 500000 } ] } } },
    { "caller": "op", "fn": "RecordRepayment", "note": "SETTLED repay illegal", "args": ["$a.invoiceId", "r4", 1000000], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "op", "fn": "MarkLate", "note": "SETTLED late illegal", "args": ["$a.invoiceId"], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "op", "fn": "MarkDefault", "note": "SETTLED default illegal", "args": ["$a.invoiceId"], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "buyer1", "fn": "BuyerAcceptInvoice", "note": "SETTLED accept illegal", "args": ["$a.invoiceId"], "expect": { "error": "ERR_INVALID_TRANSITION" } },

    { "id": "b", "caller": "msme1", "fn": "CreateInvoice", "ts": "2026-03-01T10:00:00Z", "args": ["msme1", "buyer1", 1000000, "2026-02-25", "2026-05-07", { "supplierGstin": "S", "buyerGstin": "B", "invoiceNumber": "B", "fileHash": "fb", "lineItems": [{ "description": "b", "quantity": 1, "unitPricePaise": 1, "totalPaise": 1 }] }] },
    { "caller": "buyer1", "fn": "BuyerAcceptInvoice", "args": ["$b.invoiceId"] },
    { "caller": "op", "fn": "ListInvoice", "ts": "2026-03-01T10:00:00Z", "args": ["$b.invoiceId", 800, 1] },
    { "caller": "op", "fn": "CancelInvoice", "note": "operator may cancel LISTED with 0 sold", "args": ["$b.invoiceId", "withdrawn"], "expect": { "result": { "status": "CANCELLED" } } },
    { "caller": "inv1", "fn": "Invest", "note": "CANCELLED invest illegal", "args": ["$b.invoiceId", "investor1", 1, "x7"], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "op", "fn": "ListInvoice", "note": "CANCELLED list illegal", "args": ["$b.invoiceId", 800, 1], "expect": { "error": "ERR_INVALID_TRANSITION" } },
    { "caller": "op", "fn": "ListInvoicesByStatus", "args": ["CANCELLED", 10, ""], "expect": { "result": { "items": [ { "invoiceId": "$b.invoiceId" } ] } } },
    { "caller": "op", "fn": "ListInvoicesByStatus", "args": ["LISTED", 10, ""], "expect": { "result": { "items": [] } } },
    { "caller": "op", "fn": "ListInvoicesByStatus", "args": ["SETTLED", 10, ""], "expect": { "result": { "items": [ { "invoiceId": "$a.invoiceId" } ] } } },
    { "caller": "op", "fn": "ListInvoicesByStatus", "args": ["WEIRD", 10, ""], "expect": { "error": "ERR_INVALID_ARGUMENT" } }
  ]
}
