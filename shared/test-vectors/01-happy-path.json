{
  "name": "happy path: register -> create -> accept -> list -> invest x2 -> release -> repay (on time) -> score 63 -> 67",
  "config": { "demoMode": true },
  "identities": {
    "op": { "mspId": "Org1MSP", "role": "OPERATOR", "participantId": "operator1" },
    "msme1": { "mspId": "Org1MSP", "role": "MSME", "participantId": "msme1" },
    "buyer1": { "mspId": "Org2MSP", "role": "BUYER", "participantId": "buyer1" },
    "invA": { "mspId": "Org1MSP", "role": "INVESTOR", "participantId": "investorA" },
    "invB": { "mspId": "Org1MSP", "role": "INVESTOR", "participantId": "investorB" },
    "reg": { "mspId": "Org3MSP", "role": "REGULATOR", "participantId": "regulator1" }
  },
  "steps": [
    { "caller": "op", "fn": "RegisterParticipant", "args": ["msme1", "MSME", "Org1MSP", 0], "expect": { "result": { "id": "msme1", "kycStatus": "PENDING", "frozen": false, "role": "MSME", "orgMsp": "Org1MSP" } }, "events": ["PARTICIPANT_REGISTERED"] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["buyer1", "BUYER", "Org2MSP", 0] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["investorA", "INVESTOR", "Org1MSP", 50000000] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["investorB", "INVESTOR", "Org1MSP", 50000000] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["regulator1", "REGULATOR", "Org3MSP", 0] },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["msme1", "MSME", "Org1MSP", 0], "expect": { "error": "ERR_DUPLICATE_PARTICIPANT" } },
    { "caller": "op", "fn": "RegisterParticipant", "args": ["x1", "BUYER", "Org1MSP", 0], "expect": { "error": "ERR_INVALID_ARGUMENT" }, "note": "BUYER must be Org2MSP" },
    { "caller": "op", "fn": "SetKycStatus", "args": ["msme1", "APPROVED", "a1"], "expect": { "result": { "kycStatus": "APPROVED", "kycDocHash": "a1" } }, "events": ["KYC_UPDATED"] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["buyer1", "APPROVED", "b1"] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["investorA", "APPROVED", "ia"] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["investorB", "APPROVED", "ib"] },
    { "caller": "op", "fn": "SetKycStatus", "args": ["nobody", "APPROVED", ""], "expect": { "error": "ERR_PARTICIPANT_NOT_FOUND" } },
    { "caller": "op", "fn": "SeedBuyerHistory", "args": ["buyer1", 5, 2, 0], "expect": { "result": { "score": 63, "settledOnTime": 5, "settledLate": 2, "defaulted": 0 } }, "events": ["SCORE_UPDATED", "BUYER_HISTORY_SEEDED"] },
    { "caller": "reg", "fn": "GetBuyerScore", "args": ["buyer1"], "expect": { "result": { "score": 63 } } },
    { "caller": "reg", "fn": "GetBuyerScore", "args": ["unknown-buyer"], "expect": { "result": { "score": 50, "settledOnTime": 0 } } },
    { "id": "create", "caller": "msme1", "fn": "CreateInvoice", "ts": "2026-03-01T10:00:00Z",
      "args": ["msme1", "buyer1", 40000000, "2026-02-25", "2026-05-07",
        { "supplierGstin": "27AAACS1234A1ZX", "buyerGstin": "27AABCA3456D1ZX", "invoiceNumber": "INV-2025-001", "fileHash": "1111111111111111111111111111111111111111111111111111111111111111",
          "lineItems": [ { "description": "CNC housings", "quantity": 400, "unitPricePaise": 52000, "totalPaise": 20800000 }, { "description": "Steel shafts", "quantity": 1200, "unitPricePaise": 7500, "totalPaise": 9000000 } ] }],
      "expect": { "result": { "status": "DRAFT", "totalUnits": 400, "unitsSold": 0, "faceValuePaise": 40000000, "supplierId": "msme1", "buyerId": "buyer1", "unitFaceValuePaise": 100000, "createdAt": "2026-03-01T10:00:00Z" } },
      "events": ["INVOICE_CREATED", "INVOICE_STATUS_CHANGED"] },
    { "caller": "reg", "fn": "GetInvoice", "args": ["$create.invoiceId"], "expect": { "result": { "status": "DRAFT" } } },
    { "caller": "reg", "fn": "GetInvoice", "args": ["deadbeef"], "expect": { "error": "ERR_NOT_FOUND" } },
    { "caller": "buyer1", "fn": "BuyerAcceptInvoice", "args": ["$create.invoiceId"], "expect": { "result": { "status": "BUYER_ACCEPTED" } }, "events": ["INVOICE_ACCEPTED", "INVOICE_STATUS_CHANGED"] },
    { "id": "list", "caller": "op", "fn": "ListInvoice", "ts": "2026-03-01T12:00:00Z", "args": ["$create.invoiceId", 800, 100],
      "expect": { "result": { "status": "LISTED", "tenorDays": 67, "pricePerUnitPaise": 98532, "annualizedYieldBps": 811, "discountBps": 800, "minFundingUnits": 100, "listedAt": "2026-03-01T12:00:00Z" } }, "events": ["INVOICE_LISTED"] },
    { "caller": "reg", "fn": "ListInvoicesByStatus", "args": ["LISTED", 10, ""], "expect": { "result": { "items": [ { "invoiceId": "$create.invoiceId" } ], "nextBookmark": null } } },
    { "caller": "reg", "fn": "ListInvoicesBySupplier", "args": ["msme1", 10, ""], "expect": { "result": { "items": [ { "invoiceId": "$create.invoiceId" } ] } } },
    { "caller": "reg", "fn": "ListInvoicesByBuyer", "args": ["buyer1", 10, ""], "expect": { "result": { "items": [ { "invoiceId": "$create.invoiceId" } ] } } },
    { "id": "investA", "caller": "invA", "fn": "Invest", "args": ["$create.invoiceId", "investorA", 250, "UPI-A-1"],
      "expect": { "result": { "replayed": false, "invoice": { "status": "PARTIALLY_FUNDED", "unitsSold": 250 }, "holding": { "units": 250, "costPaise": 24633000, "upiRefs": ["UPI-A-1"], "holderId": "investorA" }, "payment": { "kind": "FUNDING", "amountPaise": 24633000, "upiRef": "UPI-A-1", "fromId": "investorA" } } },
      "events": ["INVESTMENT_MADE", "INVOICE_STATUS_CHANGED"] },
    { "caller": "invA", "fn": "Invest", "args": ["$create.invoiceId", "investorA", 250, "UPI-A-1"], "note": "replay same upiRef -> idempotent, no state change",
      "expect": { "result": { "replayed": true, "invoice": { "unitsSold": 250 }, "holding": { "units": 250, "costPaise": 24633000 } } } },
    { "caller": "invB", "fn": "Invest", "args": ["$create.invoiceId", "investorB", 151, "UPI-B-0"], "expect": { "error": "ERR_UNITS_UNAVAILABLE" } },
    { "id": "investB", "caller": "invB", "fn": "Invest", "args": ["$create.invoiceId", "investorB", 150, "UPI-B-1"],
      "expect": { "result": { "invoice": { "status": "FULLY_FUNDED", "unitsSold": 400 }, "holding": { "units": 150, "costPaise": 14779800 } } } },
    { "caller": "reg", "fn": "GetHoldingsByInvoice", "args": ["$create.invoiceId"], "expect": { "result": [ { "holderId": "investorA", "units": 250 }, { "holderId": "investorB", "units": 150 } ] } },
    { "caller": "reg", "fn": "GetHoldingsByInvestor", "args": ["investorB"], "expect": { "result": [ { "invoiceId": "$create.invoiceId", "units": 150 } ] } },
    { "id": "release", "caller": "op", "fn": "ReleaseToSupplier", "ts": "2026-03-01T12:04:00Z", "args": ["$create.invoiceId", "PAYOUT-1"],
      "expect": { "result": { "invoice": { "status": "SUPPLIER_PAID", "supplierPaidAt": "2026-03-01T12:04:00Z" }, "payment": { "kind": "SUPPLIER_PAYOUT", "amountPaise": 39412800, "toId": "msme1" } } }, "events": ["SUPPLIER_PAID"] },
    { "caller": "op", "fn": "RecordRepayment", "ts": "2026-05-08T09:00:00Z", "args": ["$create.invoiceId", "REPAY-1", 39999999], "expect": { "error": "ERR_AMOUNT_MISMATCH" } },
    { "id": "repay", "caller": "op", "fn": "RecordRepayment", "ts": "2026-05-08T09:00:00Z", "args": ["$create.invoiceId", "REPAY-1", 40000000],
      "expect": { "result": { "onTime": true, "invoice": { "status": "SETTLED" }, "repayment": { "kind": "BUYER_REPAYMENT", "amountPaise": 40000000, "fromId": "buyer1" },
        "distributions": [ { "toId": "investorA", "amountPaise": 25000000, "upiRef": "REPAY-1-D0" }, { "toId": "investorB", "amountPaise": 15000000, "upiRef": "REPAY-1-D1" } ],
        "residual": null, "buyerScore": { "score": 67, "settledOnTime": 6, "settledLate": 2 } } },
      "events": ["REPAYMENT_RECORDED", "DISTRIBUTION_PAID", "SCORE_UPDATED", "INVOICE_STATUS_CHANGED"] },
    { "caller": "reg", "fn": "GetBuyerScore", "args": ["buyer1"], "expect": { "result": { "score": 67 } } },
    { "caller": "reg", "fn": "GetHoldingsByInvoice", "args": ["$create.invoiceId"], "expect": { "result": [ { "holderId": "investorA", "receivedPaise": 25000000 }, { "holderId": "investorB", "receivedPaise": 15000000 } ] } },
    { "caller": "reg", "fn": "GetPaymentsByInvoice", "args": ["$create.invoiceId"], "expect": { "result": [ { "upiRef": "PAYOUT-1" }, { "upiRef": "REPAY-1" }, { "upiRef": "REPAY-1-D0" }, { "upiRef": "REPAY-1-D1" }, { "upiRef": "UPI-A-1" }, { "upiRef": "UPI-B-1" } ] } },
    { "caller": "reg", "fn": "GetPlatformStats", "args": [], "expect": { "result": { "totalInvoices": 1, "settledInvoices": 1, "totalFundedPaise": 39412800, "activeInvestors": 2, "avgYieldBps": 811, "defaultRateBps": 0 } } },
    { "caller": "reg", "fn": "GetInvoiceHistory", "args": ["$create.invoiceId"], "expect": { "result": [ { "fn": "CreateInvoice", "value": { "status": "DRAFT" } }, { "fn": "BuyerAcceptInvoice" }, { "fn": "ListInvoice" }, { "fn": "Invest" }, { "fn": "Invest" }, { "fn": "ReleaseToSupplier" }, { "fn": "RecordRepayment", "value": { "status": "SETTLED" } } ] } },
    { "caller": "reg", "fn": "GetAuditTrail", "args": ["", "", 100, ""], "expect": { "result": { "nextBookmark": null } } }
  ]
}
