# Drunix (NPCI's Fabric fork, images on Docker Hub under npcioss/*) — image overrides for fabric-samples/test-network.
# Source this (USE_DRUNIX=true ./network/deploy.sh) BEFORE ./network.sh up. The test-network compose files read
# IMAGE_TAG / the hyperledger/* image names; Drunix ships drop-in replacements for peer, orderer and the
# validation system chaincode (vscc). NOT executed on the hackathon host (Docker unusable) — see docs/DRUNIX_NOTES.md.
#
# 1. Pull:   docker pull npcioss/drunix-peer npcioss/drunix-orderer npcioss/drunix-vscc
# 2. Re-tag so the unmodified test-network compose files pick them up (IMAGE_TAG below):
#      docker tag npcioss/drunix-peer:latest    hyperledger/fabric-peer:drunix
#      docker tag npcioss/drunix-orderer:latest hyperledger/fabric-orderer:drunix
#    (drunix-vscc is loaded by the peer as its validation plugin; mount it via
#     CORE_PEER_HANDLERS_VALIDATION_... in compose/docker-compose-test-net.yaml if the image does not bundle it)
# 3. Everything else (CA, chaincode lifecycle, collections, endorsement policy, Gateway SDK) is unchanged:
#    Drunix is wire-compatible with Fabric 2.x, so chaincode/billbridge and the backend fabric client work as-is.
export IMAGE_TAG=drunix
export CA_IMAGE_TAG=1.5
export DRUNIX_PEER_IMAGE=npcioss/drunix-peer
export DRUNIX_ORDERER_IMAGE=npcioss/drunix-orderer
export DRUNIX_VSCC_IMAGE=npcioss/drunix-vscc
